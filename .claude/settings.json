{
  "permissions": {
    "allow": [
      "Bash(pnpm tsc --noEmit)",
      "Bash(ls .github/ISSUE_TEMPLATE)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git switch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pnpm --dir app exec eslint *)",
      "Bash(pnpm --dir app exec prettier --check *)",
      "Bash(pnpm --dir app exec tsc -b)",
      "Bash(mktemp *)",
      "mcp__claude_ai_Figma__create_session",
      "mcp__claude_ai_Figma__whoami",
      "mcp__claude_ai_Figma__get_design_context",
      "mcp__claude_ai_Figma__get_screenshot",
      "mcp__claude_ai_Figma__get_metadata",
      "mcp__claude_ai_Figma__get_variable_defs",
      "mcp__claude_ai_Figma__get_comments",
      "mcp__claude_ai_Figma__search_design_system",
      "mcp__claude_ai_Figma__get_libraries",
      "mcp__claude_ai_Figma__get_code_connect_map",
      "mcp__penpot__high_level_overview",
      "mcp__penpot__penpot_api_info"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-secrets.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/set-issue-session-title.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["penpot"],
  "enabledPlugins": {
    "document-skills@anthropic-plugin-directory": true
  }
}
