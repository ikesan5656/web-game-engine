# cp .env.example .env して、下の値を設定する（.env は git に入れない）。

# Penpot のバージョン。版を上げるときは docs/penpot.md の手順に従う。
PENPOT_VERSION=2.18.7

# 秘密鍵。次のコマンドの出力を書く:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# デザインの書き出し（scripts/export-penpot.mjs）用のアクセストークン。
# Penpot のアカウント設定 → Integrations → Access tokens で発行する（期限は 90 日を推奨）。
# 詳しくは docs/penpot.md の「デザインの書き出しと復元」を参照。
PENPOT_ACCESS_TOKEN=

# Penpot の URL。変えるのは起動のポートを変えたときだけ。
PENPOT_BASE_URL=http://localhost:9001
